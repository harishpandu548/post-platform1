generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")

}


model User{
  id String @id @default(cuid())
  name String?
  email String @unique
  password String
  role Role @default(USER)
  posts Post[]
  createdAt DateTime @default(now())

}

enum Role{
  USER
  ADMIN
}

model Post{
  id String @id @default(cuid())
  imageUrl String
  ownerId String
  owner User @relation(fields: [ownerId],references: [id])
  createdAt DateTime @default(now())
}